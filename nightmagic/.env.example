# Optional. Without a key the app runs in demo mode: the pipeline and judgment
# steps use deterministic built-in logic and clearly label themselves as such.
ANTHROPIC_API_KEY=

# Model routing. Defaults shown.
NIGHTMAGIC_MODEL_PRIMARY=claude-fable-5
NIGHTMAGIC_MODEL_FAST=claude-haiku-4-5

# Where the SQLite database and uploads live. Defaults to ./data
NIGHTMAGIC_DATA_DIR=

# Set to guard every page and API route behind a shared password.
# Required for any deployment reachable from the internet. See docs/DEPLOY.md.
NIGHTMAGIC_PASSWORD=
